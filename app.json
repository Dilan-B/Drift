{
  "expo": {
    "name": "Drift",
    "slug": "drift",
    "version": "1.0.0",
    "scheme": "drift",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B1A11"
    },
    "ios": {
      "bundleIdentifier": "com.drift.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Drift needs your camera to count reps automatically using pose detection.",
        "NSMotionUsageDescription": "Drift uses motion data to detect exercise movement.",
        "NSContactsUsageDescription": "Drift can match your contacts to find friends already on Drift. Contact emails are hashed on your device and never uploaded in plain text.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.689668327094-a4ih4lefouj6ra6v0t5ht3t0g8jrmoog"
            ]
          }
        ]
      },
      "entitlements": {
        "com.apple.developer.family-controls": true
      }
    },
    "android": {
      "package": "com.drift.app",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Drift needs your camera to count reps automatically using pose detection."
        }
      ],
      "react-native-fast-tflite",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-background-task",
      "expo-notifications",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "75025803-e721-47ae-9e85-9c4c7225524f"
      }
    },
    "owner": "dilandirft"
  }
}
