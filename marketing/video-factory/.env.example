# marketing/video-factory/.env  — copy to `.env` (gitignored) and fill in.
# Nothing here belongs in the app bundle; this is a local marketing tool.

# ── Required for autopilot ───────────────────────────────────
# Writes ideas + scripts, generates the voiceover, and runs the visual QC pass.
# Without it the pipeline can still render from a --script file, but QC fails
# closed and refuses to post.
OPENAI_API_KEY=sk-...

# ── Voice (strongly recommended) ─────────────────────────────
# ElevenLabs wins over OpenAI when set. Without either, the pipeline falls back
# to the macOS `say` voice — which QC deliberately blocks from posting.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Chosen by ear over nova/coral/ash/verse — warmer and less announcer-y.
OPENAI_TTS_VOICE=sage

# ── Models (optional overrides) ──────────────────────────────
# VF_MODEL_VISION must be vision-capable or the QC gate cannot see the frames.
# VF_MODEL_TEXT=gpt-4.1-mini
# VF_MODEL_VISION=gpt-4.1-mini
# VF_MODEL_TTS=gpt-4o-mini-tts
# VF_MODEL_TRANSCRIBE=whisper-1

# ── TikTok posting ───────────────────────────────────────────
# From developers.tiktok.com — an app with the Content Posting API product.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://dilan-b.github.io/Drift/tiktok-callback.html
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload

# "direct" posts to the account; "inbox" drops it in your TikTok drafts.
TIKTOK_POST_MODE=direct

# LEAVE AS SELF_ONLY until TikTok has audited your API client. Unaudited
# clients are forced to private posting regardless of what you set here —
# the pipeline reads the allowed list from TikTok and follows it either way.
# After the audit passes, change to PUBLIC_TO_EVERYONE.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Label posts as AI-generated content. On by default — script, voice and
# visuals are all machine-made. Set to false only if you decide the label
# costs more reach than the disclosure is worth.
TIKTOK_IS_AIGC=true
