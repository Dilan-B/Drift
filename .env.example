# Copy this file to .env and fill in your keys.
# .env is gitignored. Never commit secrets.

EXPO_PUBLIC_OPENAI_KEY=sk-proj-your-key-here

# Google OAuth client IDs are public and safe to ship in the app bundle.
# The Google Web OAuth client secret belongs only in Supabase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# RevenueCat public SDK keys. Public by design — they identify the app to
# RevenueCat and can only read/purchase on behalf of the signed-in user.
# ONE KEY PER STORE; they are not interchangeable. Configuring Android with
# the Apple key authenticates against the iOS app, so every getOfferings()
# comes back empty and every purchase fails.
#
# The iOS key has a hardcoded fallback in useSubscription.js. The Android one
# deliberately does NOT: a wrong key fails exactly like a missing one, except
# a missing one says so. Until this is set, Android reports no_key_android and
# the paywall fails closed — correct, but unbuyable.
EXPO_PUBLIC_RC_IOS_KEY=appl_your-ios-key
EXPO_PUBLIC_RC_ANDROID_KEY=goog_your-android-key
